# Шаблон настроек. При первом запуске создаётся ваш личный config/lab.local.yaml —
# обновления каркаса его НЕ трогают. Заполняет помощник при онбординге.

lab_name: ""            # название вашей лаборатории
address_as: ""          # как к вам обращаться
level: ""               # технарь | не программист  — от этого зависит стиль общения
chief_name: ""          # имя главного координатора
coordinators:
  library: ""           # помощник по библиотеке/каталогу
  portal: ""            # помощник по сайту/порталу
  infra: ""             # помощник по инфраструктуре
  content: ""           # помощник по контенту
start_with: ""          # с чего начинаем

# Что было ДО лаборатории: материалы, сайты, репозитории, заметки.
# Пути и ссылки — лаборатория не переносит их к себе, а знает, где они.
prior_work: []        # что было ДО лаборатории (пути и ссылки)
#  - what: "архив записей"
#    where: "~/Documents/Лекции"
#  - what: "сайт общины"
#    where: "https://example.org"
onboarded_at: ""        # дата первого запуска
