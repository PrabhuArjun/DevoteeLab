# Данные ВЛАДЕЛЬЦА лаборатории — НЕ в git.
# git pull обновляет каркас и НЕ трогает вашу работу.
.DS_Store

# личные настройки владельца (создаётся автоматически из config/lab.yaml)
config/lab.local.yaml

# дневник лаборатории
notes/*.md

# входящие файлы
INBOX/*
!INBOX/README.md

# рабочие файлы направлений
work/*/*
!work/*/.keep

# ── Секреты: закрываем ПО ФОРМЕ имени, а не по списку известных файлов.
# Урок 12 велит никогда не класть ключи в чат — но до 01.09.2026 ничто не мешало
# положить их ФАЙЛОМ рядом с лабораторией и отправить в репозиторий вместе с ней.
#
# ⚠️ Образцы ПОДСТРОЧНЫЕ, а не по началу имени. Первая версия писала `secrets*`,
# и `client_secret.json` проходил насквозь: секрет стоял в СЕРЕДИНЕ имени, а правило
# выглядело как «секреты закрыты». Вердикт был верен, обещание — шире вердикта.
#
# ⚠️ И главное: это ФИЛЬТР, а не гарантия. Имена придумывает не он. Дыры в нём будут
# всегда — см. честную оговорку в уроке 12.
*.env
.env*
*secret*
*credential*
*парол*
*ключ*
*token*
*auth*
*service*account*
*serviceaccount*
*.pem
*.key
*.p12
*.pfx
*.sql
.npmrc
.netrc
.pgpass
.htpasswd
id_rsa*
id_ed25519*
id_ecdsa*
*.bak
