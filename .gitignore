# Данные ВЛАДЕЛЬЦА лаборатории — НЕ в git.
# git pull обновляет каркас и НЕ трогает вашу работу.
.DS_Store

# личные настройки владельца (создаётся автоматически из config/lab.yaml)
config/lab.local.yaml

# дневник лаборатории
notes/*.md

# входящие файлы
INBOX/*
!INBOX/README.md

# рабочие файлы направлений
work/*/*
!work/*/.keep

# ── Секреты: закрываем ПО ФОРМЕ, а не по списку известных имён.
# Урок 12 велит никогда не класть ключи в чат — но до 01.09.2026 ничто не мешало
# положить их ФАЙЛОМ рядом с лабораторией и отправить в репозиторий вместе с ней.
# Правило-инструкция без такого заслона держится только на памяти человека.
.env
.env.*
*.env
secrets*
*секрет*
*пароль*
*ключ*
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
*token*
*.bak
