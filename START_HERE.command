#!/bin/bash
# Лаборатория преданного — первый запуск (двойной клик на Mac)
cd "$(dirname "$0")"
clear
echo "═══════════════════════════════════════════════"
echo "   🙏  ЛАБОРАТОРИЯ — подготовка"
echo "       Цифровая библиотека и портал"
echo "═══════════════════════════════════════════════"
echo ""

# 1. Проверка Claude Code
if command -v claude >/dev/null 2>&1; then
  echo "✅ Claude Code найден: $(claude --version 2>/dev/null | head -1)"
else
  echo "⚠️  Claude Code не найден."
  echo "   1) Установите приложение: https://claude.com/claude-code"
  echo "   2) Войдите в аккаунт"
  echo "   3) Запустите этот файл ещё раз"
  open "https://claude.com/claude-code" 2>/dev/null
  echo ""
  read -p "Нажмите Enter, чтобы закрыть..." _
  exit 0
fi

# 2. Локальная память лаборатории (git — тихо, без вопросов)
if [ ! -d .git ]; then
  # Сообщение об успехе ПРИВЯЗАНО к результату, а не печатается рядом с попыткой.
  # Было: ✅ печаталось всегда — при сломанном или отсутствующем git владелец читал
  # «память включена», а памяти не было, и он бы никогда об этом не узнал.
  if git init -q 2>/dev/null && git add -A 2>/dev/null && git commit -qm "Лаборатория: первый день" 2>/dev/null && [ -d .git ]; then
    echo "✅ Память лаборатории включена (история изменений будет сохраняться)"
  else
    echo "⚠️  Память лаборатории НЕ включена: на этом компьютере не нашёлся git."
    echo "    Работать можно, но история изменений сохраняться НЕ будет."
    echo "    Если понадобится — поставьте Xcode Command Line Tools: xcode-select --install"
  fi
fi

mkdir -p INBOX notes work/library work/portal work/infra work/content lessons
# Свои уроки — отдельным файлом вне общей истории (см. .gitignore).
if [ ! -f lessons/МОИ_УРОКИ.md ]; then
  cat > lessons/МОИ_УРОКИ.md <<'МОИ'
# 📓 Мои уроки

> Это ВАШ файл. Он не уходит в общий репозиторий и не перезаписывается обновлениями.
> Общий свод — рядом, в `УРОКИ.md`: он приходит от команды Арджуны и обновляется сам.

Записывайте сюда то, обо что споткнулись сами. Формат тот же: ситуация → грабля → как надо.
Помощник читает оба файла и подсказывает из обоих.
МОИ
  if [ -s lessons/МОИ_УРОКИ.md ]; then
    echo "✅ Заведён lessons/МОИ_УРОКИ.md — сюда пишутся ВАШИ уроки"
  else
    echo "⚠️  Не удалось завести lessons/МОИ_УРОКИ.md — свои уроки пока некуда писать."
    echo "    Проверьте, что папка доступна для записи."
  fi
fi
# --- Личные настройки владельца ---
# Живут в config/lab.local.yaml (вне git — обновления их НЕ трогают).
# Если это первый запуск после обновления, а настройки уже были в config/lab.yaml —
# переносим их автоматически, чтобы ничего не потерялось.
if [ ! -f config/lab.local.yaml ]; then
  if [ -f config/lab.yaml ] && grep -qE '^[a-z_]+: *"[^"]+"' config/lab.yaml; then
    if cp config/lab.yaml config/lab.local.yaml 2>/dev/null && [ -s config/lab.local.yaml ]; then
      echo "✅ Ваши прежние настройки перенесены в config/lab.local.yaml (обновления их не затрут)"
    else
      echo "⚠️  НЕ УДАЛОСЬ перенести прежние настройки в config/lab.local.yaml."
      echo "    Ваши настройки остались в config/lab.yaml и при обновлении будут ЗАТЁРТЫ."
      echo "    Скопируйте их вручную или скажите об этом помощнику."
    fi
  elif [ -f config/lab.yaml.example ]; then
    if cp config/lab.yaml.example config/lab.local.yaml 2>/dev/null && [ -s config/lab.local.yaml ]; then
      echo "✅ Создан config/lab.local.yaml — сюда помощник запишет ваши настройки"
    else
      echo "⚠️  НЕ УДАЛОСЬ создать config/lab.local.yaml — помощнику некуда записать настройки."
      echo "    Проверьте, что папка config доступна для записи."
    fi
  fi
fi
if [ -d INBOX ] && [ -d notes ] && [ -d work ]; then
  echo "✅ Папки готовы: INBOX (входящие), notes (дневник), work (работа по направлениям)"
else
  echo "⚠️  Не все рабочие папки созданы — проверьте права на запись в этой папке."
fi
echo ""
echo "───────────────────────────────────────────────"
echo " Открываю первый разговор. Помощник представится"
echo " и задаст несколько вопросов. 🙏"
echo "───────────────────────────────────────────────"
echo ""
sleep 1

# 3. Старт Claude в папке лаборатории — С ПЕРВЫМ ЗАПРОСОМ.
#
# 🔴 До 01.09.2026 здесь стояло голое `exec claude`: открывался ПУСТОЙ разговор и молчал,
#    хотя строкой выше человеку обещано «помощник представится и задаст вопросы». Первое,
#    что видел новый владелец, — пустое поле и вопрос «а кто ходит первым?». Онбординг из
#    CLAUDE.md не запускал никто.
#    `claude` принимает первый запрос позиционно (`claude [options] [command] [prompt]`,
#    интерактивный режим по умолчанию) — этого хватает, чтобы обещание сбылось.
FIRST_PROMPT="Здравствуй. Это первый запуск лаборатории. Прочитай CLAUDE.md \
и config/lab.local.yaml. Если настройки пусты — проведи меня по первому запуску \
по одному вопросу за раз, не сваливая всё сразу. Если заполнены — просто поздоровайся \
и скажи, на чём мы остановились."

exec claude "$FIRST_PROMPT"
